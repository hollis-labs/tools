{
  "name": "fe-clipper",
  "private": true,
  "version": "0.1.0",
  "description": "Chrome MV3 web clipper for Fragments Engine — captures readable page content (Readability + Turndown) and POSTs it to FE's /v1/intake endpoint.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && node scripts/build-extension.mjs",
    "contracts:vendor": "node scripts/vendor-fe-contract.mjs",
    "contracts:generate": "openapi-typescript vendor/fragments-engine-browser-contract-v1/openapi.json --output src/generated/fragments-engine-api.ts",
    "contracts:check": "node scripts/check-generated-contract.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chrome": "0.2.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/turndown": "^5.0.6",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "5.4.21",
    "vitest": "^2.1.9"
  }
}
