{
  "issuer": { "type": "mock", "url": "http://127.0.0.1:9100" },
  "revoke_bound_seconds": 45,
  "pairs": [
    {
      "name": "torque",
      "target": "http://127.0.0.1:8990",
      "audience": "torque",
      "scopes": ["torque.read"],
      "probe": { "method": "GET", "path": "/api/v1/tasks", "ok_status": 200 },
      "enforcing": true
    },
    {
      "name": "tesseract",
      "target": "http://127.0.0.1:8089",
      "audience": "tesseract",
      "scopes": ["tesseract.read"],
      "probe": { "method": "GET", "path": "/v1/namespaces/list", "ok_status": 200 },
      "enforcing": true
    }
  ]
}
