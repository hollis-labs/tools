            $this->appendLog($logFile, '[' . $this->now() . '] Documentation written to ' . $outputFile);

            return [
                'status' => 'success',
                'message' => '{{ description }} completed successfully',
                'outputFile' => $outputFile,
                'itemsProcessed' => 0, // TODO: Add actual count
            ];
        } catch (\Exception $e) {
            $this->appendLog($logFile, '[' . $this->now() . '] ERROR: ' . $e->getMessage());

            return [
                'status' => 'failure',
                'message' => 'Failed to generate {{ generator_name }}: ' . $e->getMessage(),
                'error' => $e->getMessage(),
            ];
        }
    }

