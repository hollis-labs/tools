{
    "$schema": "https://raw.githubusercontent.com/laravel/pint/main/pint-schema.json",
    "preset": "laravel",
    "rules": {
        "binary_operator_spaces": {
            "operators": {
                "=>": "single_space",
                "=": "single_space"
            }
        },
        "concat_space": {
            "spacing": "one"
        }
    }
}
