{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "project/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "class": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "lifecycle": {
      "enum": [
        "experimental",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^(user|agency|agent|project|tool):[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "operator": {
      "type": "string",
      "pattern": "^(user|agency|agent|project|tool):[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "org": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "cli",
              "api",
              "mcp",
              "daemon",
              "gui",
              "lib",
              "plugin"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "enum": [
              "enforce",
              "loopback_open",
              "policy_gated",
              "none"
            ]
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "substrate": {
      "type": "object",
      "properties": {
        "variant": {
          "enum": [
            "service",
            "app-host",
            "headless",
            "cli",
            "microservice"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "variant",
        "profile",
        "version"
      ],
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "properties": {
        "fleet": {
          "type": "string",
          "minLength": 1
        },
        "cerberus": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "tagging": {
          "enum": [
            "semver",
            "ci-artifact-only"
          ]
        }
      },
      "required": [
        "tagging"
      ],
      "additionalProperties": false
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "owned_by",
              "operated_by",
              "responsible_for",
              "answers_to",
              "consumes",
              "part_of",
              "supersedes"
            ]
          },
          "to": {
            "type": "string",
            "pattern": "^(user|agency|agent|project|tool):[A-Za-z0-9][A-Za-z0-9._/-]*$"
          }
        },
        "required": [
          "type",
          "to"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "settings": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "type": {
      "enum": [
        "framework",
        "monorepo",
        "lib",
        "service",
        "app",
        "tool"
      ]
    },
    "disposition": {
      "enum": [
        "continue",
        "tbd",
        "experiment",
        "decompose",
        "dissolve",
        "retire",
        "parked",
        "harvested"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "lifecycle",
    "visibility",
    "owner",
    "interfaces",
    "type",
    "disposition"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "lib"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "interfaces": {
            "items": {
              "properties": {
                "type": {
                  "const": "lib"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "service",
              "app",
              "tool"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "class"
        ]
      }
    }
  ]
}
