name: build
# Publishes the release tarballs (workflow artifacts only: no tag, no release, no install) that
# `fleet-install` reads; deploy.yaml rides inside the linux/amd64 one.
on:
  push: { branches: [main] }
  pull_request: { branches: [main] }
  workflow_dispatch:
permissions: { contents: read }
jobs:
  build:
    uses: hollis-labs/tools/.github/workflows/go-app-build.yml@{{ .inputs.build_workflow_ref }}
    with:
      app: {{ .inputs.repo_name }}
      main_pkg: ./cmd/{{ .inputs.repo_name }}
{{- if .computed.frontend }}
      node_version: "24"
      ui_cmd: "cd frontend && npm ci && npm run build"
{{- end }}
      test_cmd: "go vet ./... && go test -race -count=1 ./..."
      extra_files: deploy.yaml
