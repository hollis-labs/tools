# {{ .inputs.repo_name }} on Substrate. The manifest is the shell: modules and config.
app: {{ .inputs.repo_name }}
variant: app-host
{{- if .inputs.with_frontend }}
frontend: { contributions: ui/app.json }
{{- end }}
profiles: [minimal]
modules:
  add: [secrets, auth, database, identity, cli]
config:
  logging: { level: info, format: text }
  httphost: { addr: "127.0.0.1:{{ .inputs.http_port }}" }
  database:
    sqlite: { path: {{ .inputs.repo_name }}.db }
  auth: { mode: enforce }
  identity: { key_file: identity-signing.key, session_ttl: 12h }
  secrets: { state_dir: secrets }
  # The app's own block (internal/settings); the SUBSTRATE_CONFIG file overrides it key by key.
  {{ .inputs.repo_name }}:
    allowed_hosts: []
