<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ .computed.app_title }}</title>
    <link rel="icon" href="data:," />
    <script>
      // Set the persisted theme attribute before first paint (mirrors kit-dashboard's
      // applyTheme/getInitialTheme) so the page does not flash the default palette.
      (() => {
        const KEY = "sysop.theme";
        const KNOWN = ["p1-green-phosphor", "p3-amber-phosphor", "p4-white", "hi-contrast"];
        let theme = "p4-white";
        try {
          const stored = window.localStorage.getItem(KEY);
          if (stored && KNOWN.indexOf(stored) !== -1) theme = stored;
        } catch {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
