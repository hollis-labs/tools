import { type ReactNode, useId } from "react"

export function Field({ label, children }: { label: string; children: (id: string) => ReactNode }) {
  const id = useId()
  return (
    <div className="field">
      <label htmlFor={id}>{label}</label>
      {children(id)}
    </div>
  )
}

export function Notice({ error }: { error?: string }) {
  return error ? (
    <p className="text-danger" role="alert">
      {error}
    </p>
  ) : null
}

/** The app's display name, for headings and messages. */
export const APP_NAME = "{{ .computed.app_title }}"
/** The command name, for the host-side bootstrap commands shown on screen. */
export const APP_CMD = "{{ .inputs.repo_name }}"
