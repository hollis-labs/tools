import { Button } from "@hollis-labs/design-components"
import { useState } from "react"
import { ApiError, request } from "../api/request"
import { APP_NAME, Notice } from "./forms"
import { useSession } from "./session"

/** The shell has no user-menu region, so signing out is a (footer) page with one button. */
export function SignOutPage() {
  const { name, signedOut } = useSession()
  const [error, setError] = useState("")
  async function logout() {
    try {
      await request("logout", "POST", {})
      signedOut(true)
    } catch (e) {
      if (e instanceof ApiError && e.status === 401) signedOut(true)
      else setError("Could not sign out. Please try again.")
    }
  }
  return (
    <div className="page-content">
      <div className="panel stack form-width">
        <h2>Sign out of {APP_NAME}</h2>
        <p className="text-fg-muted">
          {name ? `Signed in as ${name}. ` : ""}You will need your password to come back.
        </p>
        <Notice error={error} />
        <Button onClick={() => void logout()}>Sign out</Button>
      </div>
    </div>
  )
}
