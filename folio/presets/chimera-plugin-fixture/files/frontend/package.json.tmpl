{{ if eq .inputs.plugin_kind "dashboard" -}}
{
  "name": "{{ .inputs.project_name }}-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && npm run lint:design",
    "lint:design": "eslint src",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hollis-labs/design-app-runtime": "0.4.0",
    "@hollis-labs/design-components": "0.4.0",
    "@hollis-labs/design-tokens": "0.4.0",
    "@hollis-labs/kit-dashboard": "0.4.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@hollis-labs/plugin-registry": "0.2.0",
    "@hollis-labs/plugin-host-ui": "file:../third_party/hollis-labs-plugin-host-ui-0.1.0.tgz",
    "@hollis-labs/kit-settings": "0.2.0",
    "es-module-lexer": "1.7.0"
  },
  "devDependencies": {
    "@hollis-labs/eslint-config-design": "0.4.0",
    "eslint": "9.39.4",
    "typescript-eslint": "8.58.0",
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "@types/node": "26.6.4"
  }
}
{{ end -}}
