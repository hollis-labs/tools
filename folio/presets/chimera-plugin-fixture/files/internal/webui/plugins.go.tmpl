package webui

import (
	"embed"
	"encoding/json"
	"github.com/hollis-labs/chimera/plugins"
	"github.com/hollis-labs/plugin-sdk/registry"
	"net/http"
)

// App-owned fixture bytes only; delivery/validation come from maintained packages.
//
//go:embed fixture/bundle.js fixture/style.css
var fixture embed.FS

func recipePlugins() (http.Handler, error) {
	bytes, err := fixture.ReadFile("fixture/bundle.js")
	if err != nil {
		return nil, err
	}
	css, err := fixture.ReadFile("fixture/style.css")
	if err != nil {
		return nil, err
	}
	r := registry.NewResponse("recipe-fixture", 1)
	r.Plugins["recipe"] = registry.Plugin{OwnerGeneration: "g1", BundleURL: "/plugins/recipe/g1/bundle.js", StylesheetURL: "/plugins/recipe/g1/style.css", BundleVersion: registry.BundleDigest(bytes), Runtime: []registry.Runtime{{ "{{" }}Name: "react", Min: "19.3.0", Max: "19.3.0"}}}
	r.Kinds["widget"] = registry.KindDescriptor{SchemaVersion: 1, MetadataSchema: json.RawMessage(`{}`), Representations: []registry.Representation{registry.Component}, Regions: []string{"recipe.summary"}, RequiredCapabilities: []string{}}
	r.Regions["recipe.summary"] = registry.RegionDescriptor{Kinds: []string{"widget"}, Representations: []registry.Representation{registry.Component}, ContextSchema: json.RawMessage(`{}`), Ordering: "manifest"}
	err = r.Set(registry.Contribution{Status: registry.StatusAccepted, OwnerID: "recipe", OwnerGeneration: "g1", LocalKey: "summary", Kind: "widget", SchemaVersion: 1, Metadata: json.RawMessage(`{"label":"Reviewed local widget"}`), Representation: registry.Component, Component: &registry.ComponentRef{Export: "Summary", Region: "recipe.summary"}})
	if err != nil {
		return nil, err
	}
	return plugins.NewDelivery(r, map[string]plugins.Bundle{"recipe": {JavaScript: bytes, Stylesheet: css}}, map[string]string{"react": "19.3.0"})
}
