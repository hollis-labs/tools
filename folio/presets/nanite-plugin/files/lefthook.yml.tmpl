# lefthook.yml — shared pre-commit/pre-push hooks for the hollis-labs portfolio.
#
# CANONICAL COPY: folio preset `nanite-plugin` — `presets/nanite-plugin/files/lefthook.yml.tmpl`
# in hollis-labs/folio.
# Keep the shared commands identical to `presets/base/files/lefthook.yml.tmpl`;
# folio's own tests render both, they are not auto-derived from each other.
# Change it there and re-render. Editing this file in a generated project
# forks it: the previous shared copy claimed an upstream that no longer
# existed, and drifted into four different versions across the portfolio
# before anyone noticed.
#
# Target: all checks complete in <15 seconds on staged files only.
#
# THIS FILE ENFORCES NOTHING UNTIL `lefthook install` HAS RUN IN THE CLONE.
# A tracked lefthook.yml installs no git hooks by itself. Fresh clones must
# run `lefthook install` once.
#
# The frontend hook below is rendered only when `include_ui` is set, so a
# headless plugin never carries a lint command for a toolchain it lacks.

pre-commit:
  parallel: true
  commands:

    # ── Go parallel group ─────────────────────────────────────────────
    # These three run simultaneously on staged .go files.

    go-format:
      # Fail if any staged Go file is not gofmt + goimports clean.
      glob: "*.go"
      skip_empty: true
      run: |
        unformatted=$(gofmt -l {staged_files} 2>/dev/null)
        if command -v goimports >/dev/null 2>&1; then
          unformatted="$unformatted$(goimports -l {staged_files} 2>/dev/null)"
        fi
        if [ -n "$unformatted" ]; then
          echo "Unformatted files:"
          echo "$unformatted" | sort -u
          exit 1
        fi

    go-lint:
      # Only lints new/modified code so existing warnings don't block commits.
      glob: "*.go"
      skip_empty: true
      run: golangci-lint run --new --timeout 30s

    go-vet:
      glob: "*.go"
      skip_empty: true
      run: go vet {{ .inputs.go_packages }}

{{- if .inputs.include_ui }}

    # ── Frontend ──────────────────────────────────────────────────────

    frontend-lint:
      # Runs the LOCKFILE-INSTALLED binary from ui/, never `npx biome`.
      #
      # `npx biome` does not resolve @biomejs/biome. It resolves `biome` — an
      # unrelated env-var tool, last published 2016, whose CLI does not know
      # the word `check` and therefore exits 0 on every input, including
      # syntactically invalid TypeScript. npx fetches it unpinned from the
      # registry on each commit and reports a passing lint that never ran.
      #
      # `root:` makes {staged_files} ui-relative, which is what biome needs:
      # it resolves paths and finds biome.json against its own cwd.
      glob: "*.{ts,tsx,js,jsx}"
      root: "ui/"
      skip_empty: true
      run: ./node_modules/.bin/biome check --no-errors-on-unmatched {staged_files}
{{- end }}

pre-push:
  commands:

    go-test:
      # Full test suite gate before code reaches the remote.
      glob: "*.go"
      skip_empty: true
      run: go test {{ .inputs.go_packages }}
