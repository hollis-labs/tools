name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  go:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-go@v6
        with:
          go-version: '{{ .inputs.go_version }}'
          cache: true
      - run: go vet ./...
      - run: go build ./...
      - run: go test ./...
