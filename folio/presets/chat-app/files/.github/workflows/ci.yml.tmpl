name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  go:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-go@v6
        with:
          go-version: '{{ .inputs.go_version }}'
          cache: true
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Build and lint the chat app (including design tokens)
        working-directory: frontend
        run: |
          {{ if eq .inputs.gui_host "chimera" }}npm ci{{ else }}npm install{{ end }}
          npm run typecheck
          npm run lint
          npm run build
      - run: go mod tidy
      - run: go vet ./...
      - run: go build ./...
      - run: go test ./...
