// Command {{ .inputs.project_name }} serves the {{ .computed.app_title }} dashboard UI.
package main

import (
	"encoding/json"
	"log"
	"net/http"
	"os"

	"{{ .computed.module_path }}/internal/webui"
)

func main() {
	addr := listenAddr()

	mux := http.NewServeMux()

	// Same-origin API. The starter dashboard polls /api/health; replace
	// this with your application's real endpoints.
	mux.HandleFunc("/api/health", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]string{"status": "ok"})
	})

	// The dashboard UI — served from the embedded frontend build by go-webui.
	webui.Mount(mux)

	log.Printf("{{ .computed.app_title }} listening on %s; UI at {{ .inputs.base_path }}/", addr)
	if err := http.ListenAndServe(addr, mux); err != nil {
		log.Fatal(err)
	}
}

func listenAddr() string {
	if addr := os.Getenv("LISTEN_ADDR"); addr != "" {
		return addr
	}
	return "127.0.0.1:8080"
}
