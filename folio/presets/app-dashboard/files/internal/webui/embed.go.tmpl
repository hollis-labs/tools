{{ if eq .inputs.gui_host "chimera" -}}
// Package webui supplies embedded assets to the maintained Chimera host.
package webui

import (
	"embed"
	"io/fs"
	"net/http"

	"github.com/hollis-labs/chimera/host"
)

const BasePath = {{ quote .inputs.base_path }}

//go:embed all:dist
var embedded embed.FS

func New(routes http.Handler) (*host.Host, error) {
	assets, err := fs.Sub(embedded, "dist")
	if err != nil {
		return nil, err
	}
	return host.New(host.Config{Name: {{ quote .inputs.project_name }}, Assets: assets, BasePath: BasePath, Routes: routes})
}
{{ else -}}
// Package webui embeds the built dashboard UI frontend and serves it through
// the shared go-webui harness.
package webui

import (
	"embed"
	"io/fs"
	"net/http"

	gowebui "github.com/hollis-labs/go-webui"
)

// BasePath is the URL prefix the dashboard UI is mounted at. Keep it in sync
// with `base` in frontend/vite.config.ts.
const BasePath = "{{ .inputs.base_path }}"

// embedded holds the frontend build. `make ui-build` (vite) writes the
// real assets into dist/; until then dist/ holds only a placeholder and
// go-webui serves its "not built" page.
//
//go:embed all:dist
var embedded embed.FS

// Handler returns the http.Handler serving the embedded dashboard UI.
func Handler() http.Handler {
	dist, err := fs.Sub(embedded, "dist")
	if err != nil {
		panic("webui: embedded dist directory missing: " + err.Error())
	}
	return gowebui.Handler(gowebui.Config{FS: dist, BasePath: BasePath})
}

// Mount registers the dashboard UI handler on mux at BasePath. Both the
// trailing-slash and bare patterns are registered so {{ .inputs.base_path }}
// and {{ .inputs.base_path }}/ both resolve.
func Mount(mux *http.ServeMux) {
	h := Handler()
	mux.Handle(BasePath+"/", h)
	mux.Handle(BasePath, h)
}
{{ end -}}
